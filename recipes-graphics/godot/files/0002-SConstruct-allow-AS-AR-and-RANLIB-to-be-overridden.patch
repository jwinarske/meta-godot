From f944e0dc08396032ee9182a16ede244f0e177715 Mon Sep 17 00:00:00 2001
From: Joel Winarske <joel.winarske@gmail.com>
Date: Mon, 12 Oct 2026 17:11:46 -0700
Subject: [PATCH 2/2] SConstruct: allow AS, AR and RANLIB to be overridden

Upstream-Status: Inappropriate [oe specific]

Signed-off-by: Joel Winarske <joel.winarske@gmail.com>
---
 SConstruct | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/SConstruct b/SConstruct
index d8d9301..fd4970e 100644
--- a/SConstruct
+++ b/SConstruct
@@ -353,6 +353,9 @@ opts.Add(BoolVariable("builtin_zstd", "Use the built-in Zstd library", True))
 opts.Add("CXX", "C++ compiler binary")
 opts.Add("CC", "C compiler binary")
 opts.Add("LINK", "Linker binary")
+opts.Add("AS", "Assembler binary")
+opts.Add("AR", "Archiver binary")
+opts.Add("RANLIB", "Ranlib binary")
 opts.Add("cppdefines", "Custom defines for the pre-processor")
 opts.Add("ccflags", "Custom flags for both the C and C++ compilers")
 opts.Add("cxxflags", "Custom flags for the C++ compiler")
-- 
